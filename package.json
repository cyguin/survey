{
  "name": "@cyguin/survey",
  "version": "0.1.8",
  "description": "Post-action micro-survey system for triggering structured 1-3 question modals",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./server": {
      "import": "./dist/lib/adapter.js",
      "types": "./dist/lib/adapter.d.ts"
    },
    "./adapters/sqlite": {
      "import": "./dist/adapters/sqlite.js",
      "types": "./dist/adapters/sqlite.d.ts"
    },
    "./adapters/postgres": {
      "import": "./dist/adapters/postgres.js",
      "types": "./dist/adapters/postgres.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsup src/index.ts src/lib/adapter.ts src/adapters/sqlite.ts src/adapters/postgres.ts --format esm --dts",
    "test": "vitest run",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm run build && npm test && npm run pack:check"
  },
  "peerDependencies": {
    "next": ">=14.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.42",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "next": "^15.5.19",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.8"
  },
  "keywords": [
    "survey",
    "modal",
    "nps",
    "feedback",
    "cyguin"
  ],
  "author": {
    "name": "cyguin LLC",
    "url": "https://cyguin.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cyguin/survey.git"
  },
  "dependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^12.10.0",
    "nanoid": "^5.1.11",
    "postgres": "^3.4.9"
  }
}
